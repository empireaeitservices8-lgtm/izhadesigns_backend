# =====================================================================
# IZHA BLOOMS – ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# Copy this file to .env and supply your local or production credentials.
# Never commit real secrets to source control.
# =====================================================================

# ----------------- DATABASE -----------------
db_HOST=
db_PORT=
db_USERNAME=
db_PASSWORD=
db_DATABASE=
DB_SSL=true

# ----------------- JWT & AUTHENTICATION -----------------
JWT_SECRET=
JWT_EXPIRES_IN=7d

# ----------------- MAIN ADMIN CREDENTIALS -----------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
BACKEND_PORT=5000

# ----------------- APP ENVIRONMENT -----------------
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------- RESEND EMAIL SERVICE -----------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=onboarding@resend.dev

# ----------------- CLOUDINARY CONFIGURATION -----------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
